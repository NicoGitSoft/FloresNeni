{
  "name": "flores-neni",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "pnpm neni:bootstrap",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@neni/storefront",
    "catalog:seed": "pnpm neni:bootstrap",
    "neni:bootstrap": "pnpm --filter @dtc/backend exec medusa exec ./src/scripts/prepare-search-indexes.ts && pnpm --filter @dtc/backend exec medusa exec ./src/scripts/seed-catalogo-neni.ts",
    "neni:bootstrap:inventory-demo": "pnpm --filter @dtc/backend exec medusa exec ./src/scripts/seed-inventory-bom-demo.ts",
    "neni:setup": "bash scripts/neni-setup.sh",
    "neni:dev": "pnpm --filter @dtc/backend --filter @neni/storefront --parallel --stream dev",
    "neni:check": "bash scripts/neni-check.sh",
    "neni:test:checkout": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules pnpm --filter @dtc/backend exec jest --runInBand --runTestsByPath src/api/store/neni/checkout/__tests__/validation.unit.spec.ts",
    "neni:test:inventory": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules pnpm --filter @dtc/backend exec jest --runInBand --runTestsByPath src/utils/inventory/__tests__/material-buildable-quantity.unit.spec.ts",
    "neni:test:frontend-v3": "node --test scripts/neni-v3-smoke.test.mjs"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0"
    },
    "ignoredBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.2",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  }
}
