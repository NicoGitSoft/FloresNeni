{
  "name": "flores-neni",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "pnpm neni:bootstrap",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@neni/storefront",
    "catalog:seed": "pnpm neni:bootstrap",
    "neni:bootstrap": "pnpm --filter @dtc/backend exec medusa exec ./src/scripts/prepare-search-indexes.ts && pnpm --filter @dtc/backend exec medusa exec ./src/scripts/seed-catalogo-neni.ts",
    "neni:bootstrap:inventory-demo": "pnpm --filter @dtc/backend exec medusa exec ./src/scripts/seed-inventory-bom-demo.ts",
    "neni:setup": "bash scripts/neni-setup.sh",
    "neni:dev": "pnpm --filter @dtc/backend --filter @neni/storefront --parallel --stream dev",
    "neni:check": "bash scripts/neni-check.sh",
    "neni:test:checkout": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules pnpm --filter @dtc/backend exec jest --runInBand --runTestsByPath src/api/store/neni/checkout/__tests__/validation.unit.spec.ts",
    "neni:test:inventory": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules pnpm --filter @dtc/backend exec jest --runInBand --runTestsByPath src/utils/inventory/__tests__/material-buildable-quantity.unit.spec.ts",
    "neni:bootstrap:payments": "pnpm --filter @dtc/backend exec medusa exec ./src/scripts/bootstrap-payment-providers.ts",
    "neni:verify:payments": "pnpm --filter @dtc/backend exec medusa exec ./src/scripts/verify-payment-readiness.ts",
    "neni:test:webpay": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules pnpm --filter @dtc/backend exec jest --runInBand --runTestsByPath src/modules/webpay/__tests__/helpers.unit.spec.ts src/modules/webpay/__tests__/provider-options.unit.spec.ts",
    "neni:payments:doctor": "bash scripts/neni-payment-doctor.sh",
    "neni:dev:up": "bash scripts/neni-dev-up.sh",
    "neni:dev:status": "bash scripts/neni-dev-status.sh",
    "neni:e2e:order": "bash scripts/neni-e2e-order.sh",
    "neni:e2e:browser": "bash scripts/neni-e2e-browser.sh",
    "neni:e2e:webpay": "NENI_WEBPAY_SCENARIO=approved bash scripts/neni-e2e-webpay.sh",
    "neni:qa": "bash scripts/neni-qa-local.sh",
    "neni:qa:browser": "bash scripts/neni-qa-local.sh --browser",
    "neni:qa:webpay": "bash scripts/neni-qa-local.sh --browser --webpay",
    "neni:scripts:check": "bash -n scripts/*.sh",
    "neni:qa:fast": "pnpm neni:scripts:check && pnpm neni:test:checkout && pnpm neni:test:inventory && pnpm neni:test:webpay && pnpm neni:check",
    "neni:prepush": "bash scripts/neni-prepush.sh",
    "neni:e2e:webpay:inspect": "NENI_WEBPAY_SCENARIO=approved NENI_WEBPAY_MODE=inspect bash scripts/neni-e2e-webpay.sh",
    "neni:e2e:webpay:rejected": "NENI_WEBPAY_SCENARIO=rejected bash scripts/neni-e2e-webpay.sh",
    "neni:e2e:webpay:cancel": "NENI_WEBPAY_SCENARIO=cancel bash scripts/neni-e2e-webpay.sh"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0"
    },
    "ignoredBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.1",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14"
  }
}
